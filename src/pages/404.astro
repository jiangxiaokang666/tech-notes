---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes } from '../lib/site';
---
<BaseLayout title="页面不存在" description="没有找到这个页面。">
  <section class="page-intro"><span class="eyebrow">404 / PAGE NOT FOUND</span><h1>这一页还没有笔记。</h1><p>页面不存在，或已经移动。回到首页，换个方向继续探索。</p><a class="button primary" href={routes.home}>返回首页 <span aria-hidden="true">→</span></a></section>
</BaseLayout>
