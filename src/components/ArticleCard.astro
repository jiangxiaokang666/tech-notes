---
import type { Article } from '../lib/content';
import { sections, routes } from '../lib/site';
interface Props { article: Article; }
const { article } = Astro.props;
const section = sections.find((item) => item.key === article.collection);
const date = article.data.pubDate.toISOString().slice(0, 10);
const href = article.collection === 'learning' ? routes.learningArticle(article.id)
  : article.collection === 'algorithms' ? routes.algorithmArticle(article.id) : undefined;
---
<article class="article-row">
  <div class="article-meta"><span>{section?.label}</span><time datetime={date}>{date}</time></div>
  <h3>{href ? <a href={href}>{article.data.title}</a> : article.data.title}</h3>
  <p>{article.data.description}</p>
  <div class="article-bottom"><div class="tags">{article.data.tags.map((tag) => <span>#{tag}</span>)}</div>{href ? <a class="text-link" href={href}>{article.collection === 'learning' ? '阅读笔记' : '阅读题解'} →</a> : <span class="muted small">正文待开放</span>}</div>
</article>
