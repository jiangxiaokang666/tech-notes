---
import type { Article } from '../lib/content';
import { routes } from '../lib/site';
interface Props { articles: Article[]; }
const { articles } = Astro.props;
---
<section class="title-search" aria-label="文章标题搜索" data-title-search hidden>
  <label class="visually-hidden" for="title-query">按标题搜索</label>
  <input id="title-query" type="search" placeholder="按标题搜索" autocomplete="off" aria-controls="title-results" />
  <div class="search-panel" data-search-panel hidden>
  <p class="visually-hidden" role="status" aria-live="polite" data-search-status></p>
  <ul id="title-results" hidden>
    {articles.map((article) => (
      <li data-search-title={article.data.title} hidden>
        <a href={article.collection === 'learning' ? routes.learningArticle(article.id) : routes.algorithmArticle(article.id)}>{article.data.title}</a>
        <span class="small muted">{article.collection === 'learning' ? '学习笔记' : '算法题解'}</span>
      </li>
    ))}
  </ul>
  </div>
</section>
<script>
  const search = document.querySelector<HTMLElement>('[data-title-search]');
  if (search) {
    const input = search.querySelector<HTMLInputElement>('input')!;
    const results = search.querySelector<HTMLUListElement>('ul')!;
    const panel = search.querySelector<HTMLElement>('[data-search-panel]')!;
    const status = search.querySelector<HTMLElement>('[data-search-status]')!;
    const entries = Array.from(search.querySelectorAll<HTMLElement>('[data-search-title]'));
    const normalize = (text: string) => text.normalize('NFKC').toLowerCase();
    function update() {
      const query = normalize(input.value.trim());
      let count = 0;
      for (const entry of entries) {
        const match = query.length > 0 && normalize(entry.dataset.searchTitle ?? '').includes(query);
        entry.hidden = !match;
        if (match) count++;
      }
      results.hidden = !query || count === 0;
      panel.hidden = !query || count === 0;
      status.textContent = !query ? '' : count ? `找到 ${count} 篇文章` : '没有找到匹配的标题，请换个关键词。';
    }
    input.addEventListener('input', update);
    input.addEventListener('focus', update);
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !search.contains(event.target)) panel.hidden = true;
    });
    search.addEventListener('focusout', (event) => {
      if (!(event.relatedTarget instanceof Node) || !search.contains(event.relatedTarget)) panel.hidden = true;
    });
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { input.value = ''; update(); }
    });
    search.hidden = false;
    update();
  }
</script>
<style>
  .title-search { position: relative; width: 180px; flex-shrink: 0; }
  input { width: 100%; box-sizing: border-box; padding: 7px 10px; border: 1px solid var(--line); border-radius: 5px; background: var(--surface); color: var(--ink); font: inherit; font-size: 0.8rem; }
  input:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  input::placeholder { color: var(--muted); }
  .search-panel { position: absolute; top: calc(100% + 10px); right: 0; z-index: 20; width: min(380px, calc(100vw - 40px)); max-height: 60vh; overflow-y: auto; padding: 4px 14px; border: 1px solid var(--line); border-radius: 5px; background: var(--surface); box-shadow: 0 8px 24px #0002; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { border-bottom: 1px solid var(--line); padding: 10px 0; }
  li:last-child { border-bottom: 0; }
  li a { display: block; overflow-wrap: anywhere; font-size: 0.85rem; }
  li span { display: block; margin-top: 3px; }
  @media (max-width: 900px) { .title-search { width: 150px; } }
  @media (max-width: 600px) {
    .title-search { order: 4; width: 100%; }
    .search-panel { width: 100%; box-sizing: border-box; }
  }
</style>
