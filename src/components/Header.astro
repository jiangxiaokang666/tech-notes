---
import { navigation, routes, site } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={routes.home} aria-label={`${site.name} 首页`}>{site.name}</a>
    <nav class="desktop-navigation" aria-label="主导航">
      {navigation.map(({ href, label }) => <a href={href} aria-current={current === (href.replace(/\/$/, '') || '/') ? 'page' : undefined}>{label}</a>)}
    </nav>
    <details class="navigation">
      <summary>导航 <span aria-hidden="true">＋</span></summary>
      <nav aria-label="主导航">
        {navigation.map(({ href, label }) => <a href={href} aria-current={current === (href.replace(/\/$/, '') || '/') ? 'page' : undefined}>{label}</a>)}
      </nav>
    </details>
    <ThemeToggle />
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.navigation');
  menu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
